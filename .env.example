# Copia este archivo a .env y cambia los valores.
# Contraseña de PostgreSQL (genera una larga: openssl rand -base64 32)
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
# Puerto donde se publica la app en el servidor
MESADA_PORT=8080
# Pon true si la sirves por HTTPS (recomendado: detrás de Caddy, Nginx o Traefik)
COOKIE_SECURE=false
# Permitir crear más familias desde /configurar después de la primera
ALLOW_REGISTRATION=false
# Duración de la sesión en días
SESSION_DAYS=30
# Intentos de inicio de sesión por minuto e IP
AUTH_RATE_LIMIT=10
# Días que se conservan las copias de seguridad
BACKUP_KEEP_DAYS=14
LOG_LEVEL=info

# --- Notificaciones (correo y WhatsApp) ---
# URL pública para los enlaces de los avisos
APP_BASE_URL=http://localhost:8080
# Mientras sea false, todo es simulado: los avisos se registran pero no salen.
NOTIFY_REAL_SEND=false
NOTIFY_EMAIL_MONTHLY_CAP=100
NOTIFY_WHATSAPP_DAILY_CAP=40
# Correo: «resend» (por defecto, API HTTP con idempotencia) o «smtp» (cualquier relé SMTP, p. ej. Brevo).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=mesada@veryfacil.org
MAIL_FROM_NAME=DiploP
# Solo con EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# WhatsApp por Evolution API: URL, instancia propia y SU token (no la clave global del servidor).
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=mesada
EVOLUTION_INSTANCE_TOKEN=
# Clave para cifrar los secretos de la verificación en dos pasos (openssl rand -hex 32). Si cambia, hay que volver a activarla.
SECRET_KEY=

# --- Protección ante abusos (valores por defecto; 0 desactiva un límite) ---
# Familias nuevas, invitaciones, recuperación de acceso, subidas y descargas por IP y hora
RATE_SETUP_PER_HOUR=5
RATE_INVITE_PER_HOUR=20
RATE_INVITE_ACCEPT_PER_HOUR=20
RATE_RECOVERY_PER_HOUR=6
RATE_RESET_PER_HOUR=20
RATE_UPLOAD_PER_HOUR=60
RATE_EXPORT_PER_HOUR=6
# Topes por familia y de las fotos
MAX_MEMBERS_PER_FAMILY=20
MAX_PENDING_INVITATIONS=10
MAX_PHOTOS_PER_FAMILY=500
MAX_UPLOAD_MB=5
# Detrás de Cloudflare, la IP real llega en CF-Connecting-IP. Ponlo en false si NO hay Cloudflare delante.
TRUST_CLOUDFLARE_IP=true

# --- Copia de seguridad externa y cifrada en Cloudflare R2 (opcional) ---
# Si faltan estas cinco, no se sube nada. Pasos en docs/despliegue.md §0.b. NUNCA subas estos valores al repositorio.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Contraseña con la que se cifra cada copia (openssl rand -base64 33). Guárdala TAMBIÉN fuera del servidor: sin ella no se pueden restaurar.
BACKUP_PASSPHRASE=
R2_RETENTION_DAYS=30

# --- Fotos y limpieza ---
PHOTO_RETENTION_DAYS=7
CLEAN_NOTIFICATIONS_DAYS=90
CLEAN_OUTBOX_DAYS=90
INACTIVE_FAMILY_MONTHS=6
