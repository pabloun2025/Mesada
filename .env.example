# Copia este archivo a .env y cambia los valores.
# Contraseña de PostgreSQL (genera una larga: openssl rand -base64 32)
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga
# Puerto donde se publica la app en el servidor
MESADA_PORT=8080
# Pon true si la sirves por HTTPS (recomendado: detrás de Caddy, Nginx o Traefik)
COOKIE_SECURE=false
# Permitir crear más familias desde /configurar después de la primera
ALLOW_REGISTRATION=false
# Duración de la sesión en días
SESSION_DAYS=30
# Intentos de inicio de sesión por minuto e IP
AUTH_RATE_LIMIT=10
# Días que se conservan las copias de seguridad
BACKUP_KEEP_DAYS=14
LOG_LEVEL=info

# --- Notificaciones (correo y WhatsApp) ---
# URL pública para los enlaces de los avisos
APP_BASE_URL=http://localhost:8080
# Mientras sea false, todo es simulado: los avisos se registran pero no salen.
NOTIFY_REAL_SEND=false
NOTIFY_EMAIL_MONTHLY_CAP=100
NOTIFY_WHATSAPP_DAILY_CAP=40
# Correo: «resend» (por defecto, API HTTP con idempotencia) o «smtp» (cualquier relé SMTP, p. ej. Brevo).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=mesada@veryfacil.org
MAIL_FROM_NAME=Mesada
# Solo con EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# WhatsApp por Evolution API: URL, instancia propia y SU token (no la clave global del servidor).
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=mesada
EVOLUTION_INSTANCE_TOKEN=
